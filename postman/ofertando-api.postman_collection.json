        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refresh returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('refresh rotates both cookies', function () {",
                  "  const access = pm.cookies.get('access_token');",
                  "  const refresh = pm.cookies.get('refresh_token');",
                  "  pm.expect(access).to.be.a('string').and.not.empty;",
                  "  pm.expect(refresh).to.be.a('string').and.not.empty;",
                  "});"
                ]
