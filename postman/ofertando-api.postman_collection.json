{
  "info": {
    "_postman_id": "7b46a022-8af5-407d-bc0e-42f2a6bd0ad1",
    "name": "Ofertando Api",
    "description": "Authentication is cookie-based with two HttpOnly cookies: `access_token` (short-lived, ~15min) sent to all routes, and `refresh_token` (longer-lived, ~30d) scoped to `/auth` for token rotation. Postman handles the cookie jar automatically. No Authorization header needed on authenticated requests. Call `POST /auth/refresh` periodically (or on 401) to rotate the access token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('register returns 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('access_token cookie is set', function () {",
                  "  const cookie = pm.cookies.get('access_token');",
                  "  pm.expect(cookie).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
