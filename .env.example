NODE_ENV=development
PORT=3000
BACKEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ofertando
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/ofertando?schema=public

JWT_SECRET=change_this_secret_for_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_this_refresh_secret_for_production
REFRESH_TOKEN_EXPIRES_IN=30d

COOKIE_SECURE=false
COOKIE_DOMAIN=

REPORT_THRESHOLD=10
COMMENT_REPORT_THRESHOLD=5

OFFER_EXPIRATION_ENABLED=true
OFFER_EXPIRATION_INTERVAL=1h

GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=Ofertando/1.0 (+https://ofertando.co)
GEOCODING_LIMIT=5
GEOCODING_TIMEOUT_MS=5000
GEOCODING_THROTTLE_MS=1000
GEOCODING_CACHE_TTL_MS=300000
