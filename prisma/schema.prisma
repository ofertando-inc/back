generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OfferStatus {
  ACTIVE
  REPORTED
  DISABLED
  DELETED
  EXPIRED
}

enum VoteType {
  UP
  DOWN
}

enum ReportReason {
  EXPIRED
  UNAVAILABLE
  INCORRECT_INFO
  SCAM
  OTHER
}

enum CommentReportReason {
  SPAM
  ABUSE
  OFF_TOPIC
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ModerationAction {
  HIDE_COMMENT
  DISMISS_COMMENT
  RESTORE_COMMENT
  DISABLE_OFFER
  DISMISS_OFFER
  RESTORE_OFFER
  DISABLE_USER
  RESTORE_USER
}

enum ModerationTargetType {
  COMMENT
  OFFER
  USER
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  username     String     @unique
  passwordHash String
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  offers           Offer[]
  votes            Vote[]
  reports          Report[]
  refreshTokens    RefreshToken[]
  comments         Comment[]
  commentVotes     CommentVote[]
  commentReports   CommentReport[]
  moderationLogs   ModerationLog[] @relation("ModerationActor")
  stores           Store[]

  @@map("users")
}

model RefreshToken {
  id           String    @id
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  replacedById String?       @unique
  replacedBy   RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id])
  predecessor  RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Offer {
  id          String      @id @default(uuid())
  title       String
  description String
  offerType   String
  externalUrl String?
  storeName   String
  city        String
  startDate   DateTime
  endDate     DateTime
  status       OfferStatus @default(ACTIVE)
  score        Int         @default(0)
  reportCount  Int         @default(0)
  commentCount Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  disabledAt   DateTime?
  deletedAt    DateTime?

  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  storeId     String?
  store       Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  votes       Vote[]
  reports     Report[]
  comments    Comment[]
  categories  Category[]

  @@index([status])
  @@index([createdById])
  @@index([city])
  @@index([storeId])
  @@map("offers")
}

model Store {
  id        String   @id @default(uuid())
  name      String
  city      String
  region    String?
  address   String?
  latitude  Float?
  longitude Float?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  offers      Offer[]

  @@index([name])
  @@index([latitude, longitude])
  @@map("stores")
}

model Category {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  offers Offer[]

  @@map("categories")
}

model Vote {
  id        String   @id @default(uuid())
  type      VoteType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId  String
  offerId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
  @@index([offerId])
  @@map("votes")
}

model Report {
  id         String       @id @default(uuid())
  reason     ReportReason
  comment    String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  userId  String
  offerId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
  @@index([offerId])
  @@map("reports")
}

model Comment {
  id         String    @id @default(uuid())
  content    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  editedAt    DateTime?
  deletedAt   DateTime?
  hiddenAt    DateTime?
  score       Int       @default(0)
  replyCount  Int       @default(0)
  reportCount Int       @default(0)

  userId    String
  offerId   String
  parentId  String?
  replyToId String?
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer     Offer           @relation(fields: [offerId], references: [id], onDelete: Cascade)
  parent    Comment?        @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]       @relation("CommentThread")
  replyTo   Comment?        @relation("CommentReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  repliedBy Comment[]       @relation("CommentReplyTo")
  votes     CommentVote[]
  reports   CommentReport[]

  @@index([offerId])
  @@index([parentId])
  @@map("comments")
}

model CommentReport {
  id         String              @id @default(uuid())
  reason     CommentReportReason
  note       String?
  status     ReportStatus        @default(PENDING)
  createdAt  DateTime            @default(now())
  resolvedAt DateTime?

  userId    String
  commentId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_reports")
}

model ModerationLog {
  id         String               @id @default(uuid())
  action     ModerationAction
  targetType ModerationTargetType
  targetId   String
  reason     String?
  note       String?
  createdAt  DateTime             @default(now())

  actorId String
  actor   User   @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("moderation_logs")
}

model CommentVote {
  id        String   @id @default(uuid())
  type      VoteType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  commentId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_votes")
}
